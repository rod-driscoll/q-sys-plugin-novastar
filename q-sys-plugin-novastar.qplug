    controls["IN0"] = {
      Style = "Button",
      ButtonType = "Trigger",
      Legend = tostring(0),
      UnlinkOffColor = true,
      OffColor = Colors.White,
      Color = Colors.Red,
      Position = {SourceButton.xStart + ((SourceButton.Size[1] + SourceButton.Padding) * 4), SourceButton.yStart},
      Size = SourceButton.Size
    }

    --Second row of test buttons
    controls["TEST_VERT"] = {
      Style = "Button",
      ButtonType = "Trigger",
